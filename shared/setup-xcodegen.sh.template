#!/bin/bash
set -e

# =============================================================================
# __APP_NAME__ Development Setup (XcodeGen)
# =============================================================================
# Run after cloning, switching branches, or pulling changes to ensure the
# Xcode project is in sync with project.yml.
# =============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

CLEAN=false
QUICK=false
OPEN_XCODE=false

usage() {
    echo -e "${BOLD}__APP_NAME__ Setup Script${NC}"
    echo ""
    echo "Usage: $0 [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  --clean       Remove generated Xcode project, derived data, SPM cache"
    echo "  --quick       Skip 'swift package resolve' if Package.resolved exists"
    echo "  --open        Open Xcode workspace after setup"
    echo "  --help        Show this help message"
    exit 0
}

while [[ "$#" -gt 0 ]]; do
    case $1 in
        --clean) CLEAN=true ;;
        --quick) QUICK=true ;;
        --open) OPEN_XCODE=true ;;
        --help|-h) usage ;;
        *) echo -e "${RED}Unknown parameter: $1${NC}"; usage ;;
    esac
    shift
done

echo ""
echo -e "${BLUE}${BOLD}🛠  __APP_NAME__ Setup (XcodeGen)${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# -----------------------------------------------------------------------------
# Step 1: Prerequisites
# -----------------------------------------------------------------------------
echo -e "${CYAN}[1/4]${NC} Checking prerequisites..."

check_homebrew() {
    if ! command -v brew &> /dev/null; then
        echo -e "${YELLOW}⚠️  Homebrew not found. Installing...${NC}"
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        if [[ -f "/opt/homebrew/bin/brew" ]]; then
            eval "$(/opt/homebrew/bin/brew shellenv)"
        fi
    fi
}

check_xcodegen() {
    if ! command -v xcodegen &> /dev/null; then
        echo -e "${YELLOW}⚠️  XcodeGen not found. Installing via Homebrew...${NC}"
        check_homebrew
        brew install xcodegen
    fi
    XCODEGEN_VERSION=$(xcodegen --version 2>/dev/null | head -1 || echo "unknown")
    echo -e "   ${GREEN}✓${NC} XcodeGen ${XCODEGEN_VERSION}"
}

check_swiftlint() {
    if ! command -v swiftlint &> /dev/null; then
        echo -e "${YELLOW}⚠️  SwiftLint not found. Installing via Homebrew...${NC}"
        check_homebrew
        brew install swiftlint
    fi
    SWIFTLINT_VERSION=$(swiftlint version 2>/dev/null || echo "unknown")
    echo -e "   ${GREEN}✓${NC} SwiftLint ${SWIFTLINT_VERSION}"
}

check_xcode() {
    if ! command -v xcodebuild &> /dev/null; then
        echo -e "${RED}❌ Xcode Command Line Tools not found.${NC}"
        echo "   Install Xcode from the App Store and run: xcode-select --install"
        exit 1
    fi
    XCODE_VERSION=$(xcodebuild -version 2>/dev/null | head -1 || echo "unknown")
    echo -e "   ${GREEN}✓${NC} $XCODE_VERSION"
}

check_xcodegen
check_swiftlint
check_xcode

# -----------------------------------------------------------------------------
# Step 2: Clean (if requested)
# -----------------------------------------------------------------------------
if [ "$CLEAN" = true ]; then
    echo ""
    echo -e "${CYAN}[2/4]${NC} Cleaning build artifacts..."
    rm -rf ./*.xcodeproj ./*.xcworkspace .build DerivedData
    rm -f Package.resolved
    echo -e "   ${GREEN}✓${NC} Clean complete"
else
    echo ""
    echo -e "${CYAN}[2/4]${NC} Skipping clean (use ${YELLOW}--clean${NC} for full rebuild)"
fi

# -----------------------------------------------------------------------------
# Step 3: Generate Xcode project
# -----------------------------------------------------------------------------
echo ""
echo -e "${CYAN}[3/4]${NC} Generating Xcode project..."

if [[ ! -f "project.yml" ]]; then
    echo -e "${RED}❌ project.yml not found in $(pwd)${NC}"
    exit 1
fi

xcodegen generate
echo -e "   ${GREEN}✓${NC} Project generated"

# -----------------------------------------------------------------------------
# Step 4: Verify
# -----------------------------------------------------------------------------
echo ""
echo -e "${CYAN}[4/4]${NC} Verifying setup..."

if [ -d "__APP_NAME__.xcodeproj" ]; then
    echo -e "   ${GREEN}✓${NC} Project created successfully"
else
    echo -e "   ${RED}✗${NC} Project not found!"
    exit 1
fi

echo ""
echo -e "${GREEN}${BOLD}✅ Setup Complete!${NC}"
echo ""
echo -e "📁 Open ${BOLD}__APP_NAME__.xcodeproj${NC} to start developing"
echo ""

if [ "$OPEN_XCODE" = true ]; then
    open __APP_NAME__.xcodeproj
fi
