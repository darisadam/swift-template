#!/bin/bash
set -e

# =============================================================================
# __APP_NAME__ Development Setup (Tuist)
# =============================================================================
# Run after cloning, switching branches, or pulling changes to ensure the
# Xcode project is in sync with the Tuist manifests.
# =============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

CLEAN=false
QUICK=false
OPEN_XCODE=false

usage() {
    echo -e "${BOLD}__APP_NAME__ Setup Script${NC}"
    echo ""
    echo "Usage: $0 [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  --clean       Clean all Tuist caches, derived data, regenerate from scratch"
    echo "  --quick       Skip 'tuist install' if dependencies are already cached"
    echo "  --open        Open Xcode workspace after setup"
    echo "  --help        Show this help message"
    exit 0
}

while [[ "$#" -gt 0 ]]; do
    case $1 in
        --clean) CLEAN=true ;;
        --quick) QUICK=true ;;
        --open) OPEN_XCODE=true ;;
        --help|-h) usage ;;
        *) echo -e "${RED}Unknown parameter: $1${NC}"; usage ;;
    esac
    shift
done

echo ""
echo -e "${BLUE}${BOLD}🛠  __APP_NAME__ Setup (Tuist)${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# -----------------------------------------------------------------------------
# Step 1: Prerequisites
# -----------------------------------------------------------------------------
echo -e "${CYAN}[1/5]${NC} Checking prerequisites..."

check_homebrew() {
    if ! command -v brew &> /dev/null; then
        echo -e "${YELLOW}⚠️  Homebrew not found. Installing...${NC}"
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        if [[ -f "/opt/homebrew/bin/brew" ]]; then
            eval "$(/opt/homebrew/bin/brew shellenv)"
        fi
    fi
}

check_mise() {
    if ! command -v mise &> /dev/null; then
        echo -e "${YELLOW}⚠️  mise not found. Installing via Homebrew...${NC}"
        check_homebrew
        brew install mise
        eval "$(mise activate bash 2>/dev/null || mise activate zsh 2>/dev/null || true)"
    fi
}

check_tuist() {
    if ! command -v tuist &> /dev/null; then
        echo -e "${YELLOW}⚠️  Tuist not found. Installing via mise...${NC}"
        if command -v mise &> /dev/null; then
            mise install tuist
            mise use tuist@latest
        else
            curl -Ls https://install.tuist.io | bash
        fi
        if ! command -v tuist &> /dev/null; then
            echo -e "${RED}❌ Failed to install Tuist. Try: brew install tuist/tap/tuist${NC}"
            exit 1
        fi
    fi
    TUIST_VERSION=$(tuist version 2>/dev/null || echo "unknown")
    echo -e "   ${GREEN}✓${NC} Tuist ${TUIST_VERSION}"
}

check_swiftlint() {
    if ! command -v swiftlint &> /dev/null; then
        echo -e "${YELLOW}⚠️  SwiftLint not found. Installing via Homebrew...${NC}"
        check_homebrew
        brew install swiftlint
    fi
    SWIFTLINT_VERSION=$(swiftlint version 2>/dev/null || echo "unknown")
    echo -e "   ${GREEN}✓${NC} SwiftLint ${SWIFTLINT_VERSION}"
}

check_xcode() {
    if ! command -v xcodebuild &> /dev/null; then
        echo -e "${RED}❌ Xcode Command Line Tools not found.${NC}"
        echo "   Install Xcode from the App Store and run: xcode-select --install"
        exit 1
    fi
    XCODE_VERSION=$(xcodebuild -version 2>/dev/null | head -1 || echo "unknown")
    echo -e "   ${GREEN}✓${NC} $XCODE_VERSION"
}

check_mise
check_tuist
check_xcode
check_swiftlint

# -----------------------------------------------------------------------------
# Step 2: Clean (if requested)
# -----------------------------------------------------------------------------
if [ "$CLEAN" = true ]; then
    echo ""
    echo -e "${CYAN}[2/5]${NC} Cleaning build artifacts..."
    tuist clean 2>/dev/null || true
    rm -rf ./*.xcodeproj ./*.xcworkspace
    rm -rf Derived .build Tuist/.build Tuist/Dependencies
    echo -e "   ${GREEN}✓${NC} Clean complete"
else
    echo ""
    echo -e "${CYAN}[2/5]${NC} Skipping clean (use ${YELLOW}--clean${NC} for full rebuild)"
fi

# -----------------------------------------------------------------------------
# Step 3: Install dependencies
# -----------------------------------------------------------------------------
echo ""
if [ "$QUICK" = true ] && [ -d "Tuist/Dependencies" ]; then
    echo -e "${CYAN}[3/5]${NC} Skipping dependency install (using cached)"
else
    echo -e "${CYAN}[3/5]${NC} Installing dependencies..."
    tuist install
    echo -e "   ${GREEN}✓${NC} Dependencies installed"
fi

# -----------------------------------------------------------------------------
# Step 4: Generate Xcode project
# -----------------------------------------------------------------------------
echo ""
echo -e "${CYAN}[4/5]${NC} Generating Xcode project..."
tuist generate
echo -e "   ${GREEN}✓${NC} Project generated"

# -----------------------------------------------------------------------------
# Step 5: Verify
# -----------------------------------------------------------------------------
echo ""
echo -e "${CYAN}[5/5]${NC} Verifying setup..."

if [ -d "__APP_NAME__.xcworkspace" ]; then
    echo -e "   ${GREEN}✓${NC} Workspace created successfully"
else
    echo -e "   ${RED}✗${NC} Workspace not found!"
    exit 1
fi

echo ""
echo -e "${GREEN}${BOLD}✅ Setup Complete!${NC}"
echo ""
echo -e "📁 Open ${BOLD}__APP_NAME__.xcworkspace${NC} to start developing"
echo ""

if [ "$OPEN_XCODE" = true ]; then
    open __APP_NAME__.xcworkspace
fi
