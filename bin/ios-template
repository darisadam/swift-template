#!/usr/bin/env bash
#
# ios-template — scaffold a new iOS app from a curated template
#
# Usage:
#   ios-template list
#   ios-template new
#   ios-template new --build-system tuist --architecture clean-mvvm-repository \
#                   --name MyApp --bundle-id com.example.myapp \
#                   --org "My Org" --output ~/Projects/MyApp \
#                   --deployment-target 17.0 --swift-version 6.0
#   ios-template add-platform --in <project-dir> --platform <ios|ipados|macos|visionos|maccatalyst|watchos>
#   ios-template --help
#
# This is a pure-Bash CLI; no Python or Node needed. Templates live next to
# this script under ../templates/.

set -euo pipefail

# ── Colors ────────────────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
  RED='\033[0;31m'; GREEN='\033[0;32m'; BLUE='\033[0;34m'
  YELLOW='\033[1;33m'; CYAN='\033[0;36m'; BOLD='\033[1m'; DIM='\033[2m'; NC='\033[0m'
else
  RED=''; GREEN=''; BLUE=''; YELLOW=''; CYAN=''; BOLD=''; DIM=''; NC=''
fi

log_info()    { printf "${CYAN}▸${NC} %s\n" "$*"; }
log_success() { printf "${GREEN}✓${NC} %s\n" "$*"; }
log_warn()    { printf "${YELLOW}⚠${NC}  %s\n" "$*"; }
log_error()   { printf "${RED}✗${NC} %s\n" "$*" >&2; }
log_step()    { printf "\n${BOLD}${BLUE}%s${NC}\n" "$*"; }

# ── Paths ─────────────────────────────────────────────────────────────────────
SCRIPT_PATH="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_PATH/.." &> /dev/null && pwd)"
TEMPLATES_DIR="$REPO_ROOT/templates"
SHARED_DIR="$REPO_ROOT/shared"

# ── Usage ─────────────────────────────────────────────────────────────────────
usage() {
  cat <<EOF
${BOLD}ios-template${NC} — scaffold an iOS app from a curated template

${BOLD}Commands:${NC}
  list                          Show all available templates
  new [flags]                   Create a new project (interactive if no flags)
  add-platform [flags]          Add a platform destination to an existing project
  doctor                        Verify your machine has the required tooling

${BOLD}\`new\` flags — required choices:${NC}
  --build-system <name>         tuist | xcodegen
  --architecture <name>         simple-mvvm | modular-mvvm | clean-mvvm-repository | modular-tca
  --name <AppName>              PascalCase app name (e.g. MyApp)
  --bundle-id <com.example.x>   Reverse-DNS bundle identifier
  --org <"Org Name">            Organization name
  --output <path>               Where to create the project (default: ./<AppName>)
  --deployment-target <ver>     Min iOS version (default: 17.0)
  --swift-version <ver>         Swift version (default: 6.0)

${BOLD}\`new\` flags — optional customization:${NC}
  --devices <set>               iphone | universal | all   (default: universal)
                                  iphone     = iPhone only
                                  universal  = iPhone + iPad
                                  all        = iPhone + iPad + Mac + Vision + Catalyst
  --persistence <kind>          none | swift-data | core-data   (default depends on template)
  --test-framework <kind>       xctest | swift-testing          (default: xctest)
  --swiftlint <yes|no>          Include SwiftLint config + zero-violation policy (default: yes)
  --ci <provider>               github | gitlab | bitbucket | circleci | xcode-cloud | none
                                  (default: github)
  --ai-agents <list>            Comma-separated, any of:
                                  claude, cursor, codex, gemini, antigravity, aider, windsurf
                                  (default: claude)

${BOLD}\`new\` flags — behavior:${NC}
  --no-git                      Skip 'git init' + initial commit
  --no-setup                    Skip running setup.sh after scaffold
  -y, --yes                     Use defaults for any flag not supplied (non-interactive)

${BOLD}\`add-platform\` flags:${NC}
  --in <project-dir>            Path to the generated project (default: cwd)
  --platform <name>             ios | ipados | macos | visionos | maccatalyst | watchos

${BOLD}Examples:${NC}
  ${DIM}# Interactive — walks you through every choice:${NC}
  ios-template new

  ${DIM}# Fully scripted with all customization:${NC}
  ios-template new \\
    --build-system tuist \\
    --architecture clean-mvvm-repository \\
    --name Aurora \\
    --bundle-id com.example.aurora \\
    --org "Example Org" \\
    --output ~/Projects/Aurora \\
    --devices universal \\
    --persistence swift-data \\
    --test-framework swift-testing \\
    --swiftlint yes \\
    --ci github \\
    --ai-agents claude,cursor,gemini

  ${DIM}# Minimal — defaults for everything optional:${NC}
  ios-template new --build-system xcodegen --architecture simple-mvvm \\
    --name HelloWorld --bundle-id com.example.helloworld --org "Me" -y

  ${DIM}# Add Vision Pro support to an existing project:${NC}
  ios-template add-platform --in ~/Projects/Aurora --platform visionos
EOF
}

# ── Helpers ──────────────────────────────────────────────────────────────────
prompt() {
  # prompt <question> <default>
  local question="$1" default="${2:-}" answer
  if [[ -n "$default" ]]; then
    printf "${CYAN}?${NC} %s ${DIM}[%s]${NC}: " "$question" "$default" >&2
  else
    printf "${CYAN}?${NC} %s: " "$question" >&2
  fi
  read -r answer
  printf "%s" "${answer:-$default}"
}

prompt_choice() {
  # prompt_choice <question> <choices...>
  local question="$1"; shift
  local choices=("$@") choice
  printf "${CYAN}?${NC} %s\n" "$question" >&2
  local i=1
  for c in "${choices[@]}"; do
    printf "    ${BOLD}%d.${NC} %s\n" "$i" "$c" >&2
    ((i++))
  done
  while true; do
    printf "${CYAN}▸${NC} Enter number [1-${#choices[@]}]: " >&2
    read -r choice
    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#choices[@]} )); then
      printf "%s" "${choices[$((choice - 1))]}"
      return
    fi
    log_warn "Please enter a number between 1 and ${#choices[@]}"
  done
}

prompt_yes_no() {
  # prompt_yes_no <question> <default-yes-or-no>  →  echoes "yes" or "no"
  local question="$1" default="${2:-yes}" answer
  local hint
  if [[ "$default" == "yes" ]]; then hint="Y/n"; else hint="y/N"; fi
  while true; do
    printf "${CYAN}?${NC} %s ${DIM}[%s]${NC}: " "$question" "$hint" >&2
    read -r answer
    answer="${answer:-$default}"
    case "$answer" in
      y|Y|yes|YES|Yes) printf "yes"; return ;;
      n|N|no|NO|No)    printf "no"; return ;;
      *) log_warn "Please answer y or n" ;;
    esac
  done
}

prompt_multi() {
  # prompt_multi <question> <default-csv> <choices...>  → echoes csv of chosen items
  local question="$1" default_csv="$2"; shift 2
  local choices=("$@") raw selected=()
  printf "${CYAN}?${NC} %s\n" "$question" >&2
  local i=1
  for c in "${choices[@]}"; do
    printf "    ${BOLD}%d.${NC} %s\n" "$i" "$c" >&2
    ((i++))
  done
  printf "${CYAN}▸${NC} Enter numbers separated by commas (e.g. 1,3) ${DIM}[%s]${NC}: " "$default_csv" >&2
  read -r raw
  raw="${raw:-$default_csv}"
  # Allow user to type numbers OR comma-separated names directly
  if [[ "$raw" =~ ^[0-9,[:space:]]+$ ]]; then
    local IFS=','
    for n in $raw; do
      n="${n// /}"
      if [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#choices[@]} )); then
        selected+=("${choices[$((n - 1))]}")
      fi
    done
  else
    # Treat as direct names
    local IFS=','
    for name in $raw; do
      name="${name// /}"
      selected+=("$name")
    done
  fi
  ( IFS=','; printf '%s' "${selected[*]}" )
}

# Returns 0 if csv list contains item.  Usage: csv_contains "a,b,c" "b"
csv_contains() {
  local csv="$1" item="$2"
  case ",$csv," in
    *",$item,"*) return 0 ;;
    *) return 1 ;;
  esac
}

# JSON-free parser for template.json fields we care about. Pure POSIX awk.
# Usage: read_field <file> <key>  →  prints value (no quotes)
read_field() {
  local file="$1" key="$2"
  awk -v key="$key" '
    {
      if (match($0, "\"" key "\"[[:space:]]*:[[:space:]]*\"[^\"]*\"")) {
        v = substr($0, RSTART, RLENGTH)
        sub("\"" key "\"[[:space:]]*:[[:space:]]*\"", "", v)
        sub("\"$", "", v)
        print v
        exit
      }
    }
  ' "$file"
}

# Replace placeholders in every text file under a directory tree.
substitute_placeholders() {
  local root="$1"
  local app_name="$2" bundle_id="$3" org_name="$4"
  local swift_version="$5" deployment_target="$6"
  local arch_name="$7" build_system="$8"

  # Escape for sed
  local sed_app sed_bundle sed_org sed_swift sed_dep sed_arch sed_bs
  sed_app="$(printf '%s' "$app_name" | sed 's:[][\\/.^$*]:\\&:g')"
  sed_bundle="$(printf '%s' "$bundle_id" | sed 's:[][\\/.^$*]:\\&:g')"
  sed_org="$(printf '%s' "$org_name" | sed 's:[][\\/.^$*]:\\&:g')"
  sed_swift="$(printf '%s' "$swift_version" | sed 's:[][\\/.^$*]:\\&:g')"
  sed_dep="$(printf '%s' "$deployment_target" | sed 's:[][\\/.^$*]:\\&:g')"
  sed_arch="$(printf '%s' "$arch_name" | sed 's:[][\\/.^$*]:\\&:g')"
  sed_bs="$(printf '%s' "$build_system" | sed 's:[][\\/.^$*]:\\&:g')"

  # Find every text file (Swift, YAML, JSON, MD, plist, sh, swiftlint) and substitute
  while IFS= read -r -d '' file; do
    # Skip binary files just in case
    if LC_ALL=C grep -lI . "$file" > /dev/null 2>&1; then
      sed -i.bak \
        -e "s/__APP_NAME__/$sed_app/g" \
        -e "s/__BUNDLE_ID__/$sed_bundle/g" \
        -e "s/__ORG_NAME__/$sed_org/g" \
        -e "s/__SWIFT_VERSION__/$sed_swift/g" \
        -e "s/__DEPLOYMENT_TARGET__/$sed_dep/g" \
        -e "s/__ARCHITECTURE_NAME__/$sed_arch/g" \
        -e "s/__BUILD_SYSTEM__/$sed_bs/g" \
        "$file"
      rm -f "$file.bak"
    fi
  done < <(find "$root" -type f \
    \( -name "*.swift" -o -name "*.yml" -o -name "*.yaml" -o -name "*.json" \
       -o -name "*.md" -o -name "*.mdc" -o -name "*.plist" -o -name "*.sh" -o -name "*.toml" \
       -o -name ".swiftlint.yml" -o -name ".swiftformat" -o -name ".gitignore" \
       -o -name ".cursorrules" -o -name ".windsurfrules" -o -name ".editorconfig" \
       -o -name "Info.plist" -o -name "Package.swift" \) \
    -print0)
}

# Rename any file/directory whose basename contains __APP_NAME__.
# Walks deepest-first; renames ONLY the basename so an unrenamed parent dir
# doesn't cause a "destination does not exist" mv error.
rename_app_name_paths() {
  local root="$1" app_name="$2"
  while IFS= read -r -d '' path; do
    local dir base new_base
    dir="$(dirname "$path")"
    base="$(basename "$path")"
    new_base="${base//__APP_NAME__/$app_name}"
    if [[ "$base" != "$new_base" ]]; then
      mv "$path" "$dir/$new_base"
    fi
  done < <(find "$root" -depth -name "*__APP_NAME__*" -print0)
}

list_templates() {
  printf "\n${BOLD}Available templates${NC}\n\n"
  printf "  ${DIM}%-12s %-30s %s${NC}\n" "BUILD" "ARCHITECTURE" "DESCRIPTION"
  printf "  ${DIM}%-12s %-30s %s${NC}\n" "-----" "------------" "-----------"
  for bs_dir in "$TEMPLATES_DIR"/*/; do
    local bs
    bs="$(basename "$bs_dir")"
    for arch_dir in "$bs_dir"*/; do
      local arch_key meta_file name desc
      arch_key="$(basename "$arch_dir")"
      meta_file="$arch_dir/template.json"
      if [[ -f "$meta_file" ]]; then
        name="$(read_field "$meta_file" "architecture")"
        desc="$(read_field "$meta_file" "description")"
        # Truncate description for display
        if (( ${#desc} > 65 )); then
          desc="${desc:0:62}..."
        fi
        printf "  %-12s %-30s %s\n" "$bs" "$arch_key" "$desc"
      fi
    done
  done
  printf "\n${DIM}Run ${NC}${BOLD}ios-template new${NC}${DIM} to scaffold a project interactively.${NC}\n\n"
}

doctor() {
  log_step "Checking your environment…"
  local ok=1

  if command -v xcodebuild >/dev/null 2>&1; then
    log_success "Xcode: $(xcodebuild -version | head -1)"
  else
    log_error "Xcode Command Line Tools not found. Run: xcode-select --install"
    ok=0
  fi

  if command -v swiftlint >/dev/null 2>&1; then
    log_success "SwiftLint: $(swiftlint version)"
  else
    log_warn "SwiftLint not found (will be installed when you run setup.sh)"
  fi

  if command -v tuist >/dev/null 2>&1; then
    log_success "Tuist: $(tuist version 2>/dev/null || echo unknown)"
  else
    log_warn "Tuist not installed (only needed for Tuist templates)"
  fi

  if command -v xcodegen >/dev/null 2>&1; then
    log_success "XcodeGen: $(xcodegen --version 2>/dev/null | head -1 || echo unknown)"
  else
    log_warn "XcodeGen not installed (only needed for XcodeGen templates)"
  fi

  if command -v mise >/dev/null 2>&1; then
    log_success "mise: $(mise --version)"
  else
    log_warn "mise not installed (recommended for Tuist version pinning)"
  fi

  if command -v git >/dev/null 2>&1; then
    log_success "git: $(git --version)"
  else
    log_warn "git not found"
  fi

  echo
  if (( ok == 1 )); then
    log_success "You're good to scaffold a project."
  else
    log_error "Fix the issues above before running 'new'."
    exit 1
  fi
}

# ── Sub-command: new ─────────────────────────────────────────────────────────
cmd_new() {
  local build_system="" architecture="" app_name="" bundle_id=""
  local org_name="" output_dir="" deployment_target="" swift_version=""
  local devices="" persistence="" test_framework="" swiftlint_opt=""
  local ci_provider="" ai_agents=""
  local do_git=1 do_setup=1 use_defaults=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --build-system)      build_system="$2"; shift 2 ;;
      --architecture)      architecture="$2"; shift 2 ;;
      --name)              app_name="$2"; shift 2 ;;
      --bundle-id)         bundle_id="$2"; shift 2 ;;
      --org)               org_name="$2"; shift 2 ;;
      --output)            output_dir="$2"; shift 2 ;;
      --deployment-target) deployment_target="$2"; shift 2 ;;
      --swift-version)     swift_version="$2"; shift 2 ;;
      --devices)           devices="$2"; shift 2 ;;
      --persistence)       persistence="$2"; shift 2 ;;
      --test-framework)    test_framework="$2"; shift 2 ;;
      --swiftlint)         swiftlint_opt="$2"; shift 2 ;;
      --ci)                ci_provider="$2"; shift 2 ;;
      --ai-agents)         ai_agents="$2"; shift 2 ;;
      --no-git)            do_git=0; shift ;;
      --no-setup)          do_setup=0; shift ;;
      -y|--yes)            use_defaults=1; shift ;;
      -h|--help)           usage; exit 0 ;;
      *) log_error "Unknown flag: $1"; usage; exit 1 ;;
    esac
  done

  log_step "🦅  ios-template — new project"

  # Interactive fill-in
  if [[ -z "$build_system" ]]; then
    build_system="$(prompt_choice "Build system?" "tuist" "xcodegen")"
  fi
  if [[ ! -d "$TEMPLATES_DIR/$build_system" ]]; then
    log_error "Unknown build system: $build_system"
    exit 1
  fi

  if [[ -z "$architecture" ]]; then
    local archs=()
    for d in "$TEMPLATES_DIR/$build_system"/*/; do
      archs+=("$(basename "$d")")
    done
    architecture="$(prompt_choice "Architecture?" "${archs[@]}")"
  fi

  local template_dir="$TEMPLATES_DIR/$build_system/$architecture"
  if [[ ! -d "$template_dir" ]]; then
    log_error "Template not found: $build_system/$architecture"
    log_info "Run 'ios-template list' to see available templates."
    exit 1
  fi

  if [[ -z "$app_name" ]]; then
    app_name="$(prompt "App name (PascalCase)" "MyApp")"
  fi
  if [[ ! "$app_name" =~ ^[A-Z][A-Za-z0-9]*$ ]]; then
    log_error "App name must be PascalCase (letters/digits only, starting uppercase). Got: '$app_name'"
    exit 1
  fi

  if [[ -z "$bundle_id" ]]; then
    local default_bundle="com.example.$(printf '%s' "$app_name" | tr '[:upper:]' '[:lower:]')"
    bundle_id="$(prompt "Bundle ID (reverse-DNS)" "$default_bundle")"
  fi
  if [[ ! "$bundle_id" =~ ^[a-z][a-z0-9]*(\.[a-z0-9][a-z0-9-]*)+$ ]]; then
    log_warn "Bundle ID '$bundle_id' looks unusual. Continuing anyway."
  fi

  if [[ -z "$org_name" ]]; then
    org_name="$(prompt "Organization name" "Example Org")"
  fi

  if [[ -z "$output_dir" ]]; then
    output_dir="$(prompt "Output directory" "./$app_name")"
  fi
  # Expand ~ manually since we don't use eval
  output_dir="${output_dir/#\~/$HOME}"

  if [[ -e "$output_dir" ]]; then
    log_error "Output directory already exists: $output_dir"
    exit 1
  fi

  if [[ -z "$deployment_target" ]]; then
    if (( use_defaults )); then
      deployment_target="17.0"
    else
      deployment_target="$(prompt "iOS deployment target" "17.0")"
    fi
  fi

  if [[ -z "$swift_version" ]]; then
    if (( use_defaults )); then
      swift_version="6.0"
    else
      swift_version="$(prompt "Swift version" "6.0")"
    fi
  fi

  # Devices
  if [[ -z "$devices" ]]; then
    if (( use_defaults )); then
      devices="universal"
    else
      devices="$(prompt_choice "Target devices?" "universal (iPhone + iPad)" "iphone (iPhone only)" "all (+ Mac, Vision, Catalyst)")"
      # Strip suffixes; keep the keyword
      devices="${devices%% *}"
    fi
  fi
  case "$devices" in
    iphone|universal|all) ;;
    *) log_error "--devices must be one of: iphone, universal, all"; exit 1 ;;
  esac

  # Persistence — only meaningful for modular/clean templates; ignored otherwise
  if [[ -z "$persistence" ]]; then
    case "$architecture" in
      clean-mvvm-repository)
        if (( use_defaults )); then
          persistence="swift-data"
        else
          persistence="$(prompt_choice "Persistence?" "swift-data" "core-data" "none")"
        fi ;;
      *)
        persistence="none" ;;
    esac
  fi
  case "$persistence" in
    none|swift-data|core-data) ;;
    *) log_error "--persistence must be one of: none, swift-data, core-data"; exit 1 ;;
  esac

  # Test framework
  if [[ -z "$test_framework" ]]; then
    if (( use_defaults )); then
      test_framework="xctest"
    else
      test_framework="$(prompt_choice "Test framework?" "xctest" "swift-testing")"
    fi
  fi
  case "$test_framework" in
    xctest|swift-testing) ;;
    *) log_error "--test-framework must be one of: xctest, swift-testing"; exit 1 ;;
  esac

  # SwiftLint
  if [[ -z "$swiftlint_opt" ]]; then
    if (( use_defaults )); then
      swiftlint_opt="yes"
    else
      swiftlint_opt="$(prompt_yes_no "Include SwiftLint config?" "yes")"
    fi
  fi
  case "$swiftlint_opt" in
    yes|no) ;;
    *) log_error "--swiftlint must be 'yes' or 'no'"; exit 1 ;;
  esac

  # CI provider
  if [[ -z "$ci_provider" ]]; then
    if (( use_defaults )); then
      ci_provider="github"
    else
      ci_provider="$(prompt_choice "CI provider?" "github" "gitlab" "bitbucket" "circleci" "xcode-cloud" "none")"
    fi
  fi
  case "$ci_provider" in
    github|gitlab|bitbucket|circleci|xcode-cloud|none) ;;
    *) log_error "--ci must be one of: github, gitlab, bitbucket, circleci, xcode-cloud, none"; exit 1 ;;
  esac

  # AI agent files (multi-select)
  if [[ -z "$ai_agents" ]]; then
    if (( use_defaults )); then
      ai_agents="claude"
    else
      ai_agents="$(prompt_multi "AI agent config files? (comma-separated)" "1" \
        "claude" "cursor" "codex" "gemini" "antigravity" "aider" "windsurf")"
    fi
  fi

  local arch_name
  arch_name="$(read_field "$template_dir/template.json" "architecture")"

  printf "\n${BOLD}Summary${NC}\n"
  printf "  Build system:        ${CYAN}%s${NC}\n" "$build_system"
  printf "  Architecture:        ${CYAN}%s${NC}\n" "$arch_name"
  printf "  App name:            ${CYAN}%s${NC}\n" "$app_name"
  printf "  Bundle ID:           ${CYAN}%s${NC}\n" "$bundle_id"
  printf "  Organization:        ${CYAN}%s${NC}\n" "$org_name"
  printf "  Output:              ${CYAN}%s${NC}\n" "$output_dir"
  printf "  Deployment target:   ${CYAN}iOS %s${NC}\n" "$deployment_target"
  printf "  Swift version:       ${CYAN}%s${NC}\n" "$swift_version"
  printf "  Devices:             ${CYAN}%s${NC}\n" "$devices"
  printf "  Persistence:         ${CYAN}%s${NC}\n" "$persistence"
  printf "  Test framework:      ${CYAN}%s${NC}\n" "$test_framework"
  printf "  SwiftLint:           ${CYAN}%s${NC}\n" "$swiftlint_opt"
  printf "  CI:                  ${CYAN}%s${NC}\n" "$ci_provider"
  printf "  AI agents:           ${CYAN}%s${NC}\n" "$ai_agents"
  printf "  Run setup.sh:        ${CYAN}%s${NC}\n" "$([[ $do_setup -eq 1 ]] && echo yes || echo no)"
  printf "  Init git:            ${CYAN}%s${NC}\n" "$([[ $do_git -eq 1 ]] && echo yes || echo no)"

  if (( use_defaults == 0 )); then
    local confirm
    confirm="$(prompt "Proceed?" "yes")"
    if [[ ! "$confirm" =~ ^(y|yes|Y|YES)$ ]]; then
      log_warn "Cancelled."
      exit 1
    fi
  fi

  log_step "Copying template…"
  mkdir -p "$(dirname "$output_dir")"
  # cp -R preserves the tree, then we substitute and rename.
  cp -R "$template_dir" "$output_dir"
  # Remove the template-internal metadata file from the generated project
  rm -f "$output_dir/template.json"
  log_success "Template copied"

  log_step "Adding shared assets…"
  # Always-on: gitignore, editorconfig, mise.toml
  cp "$SHARED_DIR/git/.gitignore" "$output_dir/.gitignore"
  cp "$SHARED_DIR/.editorconfig" "$output_dir/.editorconfig"
  cp "$SHARED_DIR/mise.toml.template" "$output_dir/mise.toml"

  # SwiftLint (optional)
  if [[ "$swiftlint_opt" == "yes" ]]; then
    cp "$SHARED_DIR/linting/.swiftlint.yml" "$output_dir/.swiftlint.yml"
    cp "$SHARED_DIR/linting/.swiftformat" "$output_dir/.swiftformat"
    log_info "SwiftLint config added"
  else
    log_info "SwiftLint config skipped (--swiftlint no)"
  fi

  # AI agent files (multi-select)
  local agents_added=""
  if csv_contains "$ai_agents" "claude"; then
    cp "$SHARED_DIR/ai/CLAUDE.md.template" "$output_dir/CLAUDE.md"
    mkdir -p "$output_dir/.claude/commands"
    cp "$SHARED_DIR/ai/.claude/settings.json.template" "$output_dir/.claude/settings.json"
    cp "$SHARED_DIR/ai/.claude/commands/"*.md "$output_dir/.claude/commands/"
    agents_added+=" claude"
  fi
  if csv_contains "$ai_agents" "cursor"; then
    cp "$SHARED_DIR/ai/.cursorrules.template" "$output_dir/.cursorrules"
    mkdir -p "$output_dir/.cursor/rules"
    cp "$SHARED_DIR/ai/.cursor/rules/main.mdc.template" "$output_dir/.cursor/rules/main.mdc"
    agents_added+=" cursor"
  fi
  if csv_contains "$ai_agents" "codex" || csv_contains "$ai_agents" "agents"; then
    cp "$SHARED_DIR/ai/AGENTS.md.template" "$output_dir/AGENTS.md"
    agents_added+=" codex(AGENTS.md)"
  fi
  if csv_contains "$ai_agents" "gemini"; then
    cp "$SHARED_DIR/ai/GEMINI.md.template" "$output_dir/GEMINI.md"
    agents_added+=" gemini"
  fi
  if csv_contains "$ai_agents" "antigravity"; then
    cp "$SHARED_DIR/ai/ANTIGRAVITY.md.template" "$output_dir/ANTIGRAVITY.md"
    agents_added+=" antigravity"
  fi
  if csv_contains "$ai_agents" "aider"; then
    cp "$SHARED_DIR/ai/CONVENTIONS.md.template" "$output_dir/CONVENTIONS.md"
    agents_added+=" aider(CONVENTIONS.md)"
  fi
  if csv_contains "$ai_agents" "windsurf"; then
    cp "$SHARED_DIR/ai/.windsurfrules.template" "$output_dir/.windsurfrules"
    agents_added+=" windsurf"
  fi
  if [[ -n "$agents_added" ]]; then
    log_info "AI agents added:$agents_added"
  else
    log_warn "No AI agent files added"
  fi

  # CI provider
  case "$ci_provider" in
    github)
      mkdir -p "$output_dir/.github/workflows"
      cp "$SHARED_DIR/ci/github-actions-ci.yml" "$output_dir/.github/workflows/ci.yml"
      log_info "CI: GitHub Actions (.github/workflows/ci.yml)"
      ;;
    gitlab)
      cp "$SHARED_DIR/ci/gitlab-ci.yml" "$output_dir/.gitlab-ci.yml"
      log_info "CI: GitLab CI (.gitlab-ci.yml)"
      ;;
    bitbucket)
      cp "$SHARED_DIR/ci/bitbucket-pipelines.yml" "$output_dir/bitbucket-pipelines.yml"
      log_info "CI: Bitbucket Pipelines (bitbucket-pipelines.yml)"
      ;;
    circleci)
      mkdir -p "$output_dir/.circleci"
      cp "$SHARED_DIR/ci/circleci-config.yml" "$output_dir/.circleci/config.yml"
      log_info "CI: CircleCI (.circleci/config.yml)"
      ;;
    xcode-cloud)
      cp "$SHARED_DIR/ci/XCODE_CLOUD.md" "$output_dir/XCODE_CLOUD.md"
      log_info "CI: Xcode Cloud (see XCODE_CLOUD.md for setup)"
      ;;
    none)
      log_info "CI: none (skipped)"
      ;;
  esac

  # Test framework — overlay swift-testing variant when applicable
  if [[ "$test_framework" == "swift-testing" ]]; then
    case "$architecture" in
      simple-mvvm)
        local variant="$SHARED_DIR/variants/test-framework-swift-testing/simple-mvvm-CounterViewModelTests.swift"
        if [[ -f "$variant" ]]; then
          cp "$variant" "$output_dir/__APP_NAME__Tests/CounterViewModelTests.swift"
          log_info "Test framework: Swift Testing (replaced XCTest sample)"
        fi
        ;;
      *)
        log_warn "Swift Testing variant for $architecture not provided yet — keeping XCTest sample"
        ;;
    esac
  fi

  # Persistence — Core Data variant (clean-mvvm-repository only)
  if [[ "$persistence" == "core-data" && "$architecture" == "clean-mvvm-repository" ]]; then
    local cd_src="$SHARED_DIR/variants/persistence-core-data/CoreDataController.swift"
    local cd_dst="$output_dir/Modules/Core/CorePersistence/Sources/CoreDataController.swift"
    if [[ -f "$cd_src" && -d "$(dirname "$cd_dst")" ]]; then
      cp "$cd_src" "$cd_dst"
      # Remove the SwiftData controller so only one is active
      rm -f "$output_dir/Modules/Core/CorePersistence/Sources/PersistenceController.swift"
      log_info "Persistence: Core Data (CoreDataController.swift)"
    else
      log_warn "Couldn't apply Core Data variant for this template"
    fi
  fi

  # Project-level README — replace the template's per-template README (which is a tour, not a project README)
  # Save the tour as TEMPLATE_GUIDE.md in the generated project for reference.
  if [[ -f "$output_dir/README.md" ]]; then
    mv "$output_dir/README.md" "$output_dir/TEMPLATE_GUIDE.md"
  fi
  cp "$SHARED_DIR/PROJECT_README.md.template" "$output_dir/README.md"

  # Pick the right setup.sh template
  if [[ "$build_system" == "xcodegen" ]]; then
    cp "$SHARED_DIR/setup-xcodegen.sh.template" "$output_dir/setup.sh"
  else
    cp "$SHARED_DIR/setup-tuist.sh.template" "$output_dir/setup.sh"
  fi
  chmod +x "$output_dir/setup.sh"
  log_success "Shared assets copied"

  log_step "Substituting placeholders…"
  # Derive aux fields for templated CLAUDE.md / AGENTS.md / GEMINI.md / etc.
  # IMPORTANT: these strings themselves contain __APP_NAME__, so we expand
  # __APP_NAME__ inside them BEFORE injecting them into the docs.
  local generate_cmd test_cmd config_file platforms_str open_command
  generate_cmd="$(read_field "$template_dir/template.json" "generateCommand")"
  test_cmd="$(read_field "$template_dir/template.json" "testCommand")"
  config_file="$(read_field "$template_dir/template.json" "configFile")"

  # Devices → platforms string for docs
  case "$devices" in
    iphone)    platforms_str="iPhone" ;;
    universal) platforms_str="iPhone, iPad" ;;
    all)       platforms_str="iPhone, iPad, Mac, Vision Pro, macCatalyst" ;;
  esac

  # Open command depends on build system
  if [[ "$build_system" == "tuist" ]]; then
    open_command="open ${app_name}.xcworkspace"
  else
    open_command="open ${app_name}.xcodeproj"
  fi

  generate_cmd="${generate_cmd//__APP_NAME__/$app_name}"
  test_cmd="${test_cmd//__APP_NAME__/$app_name}"
  config_file="${config_file//__APP_NAME__/$app_name}"

  # Escape sed REPLACEMENT-side metacharacters: \, &, and the delimiter |.
  # Unescaped, `&` in `tuist install && tuist generate` would expand to the
  # entire matched pattern (`__GENERATE_COMMAND__`), corrupting the output.
  sed_escape_replacement() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/&/\\&/g' -e 's/|/\\|/g'
  }
  local generate_cmd_esc test_cmd_esc config_file_esc platforms_esc open_command_esc
  local modules_block_esc config_block_esc arch_summary_esc
  generate_cmd_esc="$(sed_escape_replacement "$generate_cmd")"
  test_cmd_esc="$(sed_escape_replacement "$test_cmd")"
  config_file_esc="$(sed_escape_replacement "$config_file")"
  platforms_esc="$(sed_escape_replacement "$platforms_str")"
  open_command_esc="$(sed_escape_replacement "$open_command")"

  # Conditional blocks for PROJECT_README.md
  local modules_block="" config_block="" arch_summary=""
  case "$architecture" in
    simple-mvvm) modules_block="" ;;
    *) modules_block="├── Modules/                        # Core + Feature modules\n" ;;
  esac
  if [[ "$build_system" == "tuist" ]]; then
    if [[ "$architecture" == "simple-mvvm" ]]; then
      config_block="├── Project.swift                   # Tuist project manifest\n├── Tuist.swift                     # Tuist toolchain pin\n"
    else
      config_block="├── Project.swift                   # app target manifest\n├── Workspace.swift                 # workspace = root + modules\n├── Tuist.swift                     # Tuist toolchain pin\n├── Tuist/                          # Tuist plumbing\n"
    fi
  else
    config_block="├── project.yml                     # XcodeGen project config\n"
  fi
  case "$architecture" in
    simple-mvvm)              arch_summary="One Xcode target. SwiftUI views with @Observable @MainActor view models. Best for small apps and learning." ;;
    modular-mvvm)             arch_summary="Per-feature modules under Modules/. The app target wires them together via CoreNavigation. Features cannot depend on other features." ;;
    clean-mvvm-repository)    arch_summary="Per-feature Domain/Data/Presentation layers. Repository protocols live in Domain. The Composition Root in App/Sources/AppComposer.swift wires real implementations." ;;
    modular-tca)              arch_summary="Each feature is a @Reducer; AppFeature composes children via Scope. State is value types, mutations happen only in reducers. TestStore-driven tests." ;;
  esac
  modules_block_esc="$(sed_escape_replacement "$modules_block")"
  config_block_esc="$(sed_escape_replacement "$config_block")"
  arch_summary_esc="$(sed_escape_replacement "$arch_summary")"

  # Pass 1: AI-doc-specific tokens. Do this BEFORE the broad substitution so
  # the resulting test/generate commands get their __APP_NAME__ replaced too.
  while IFS= read -r -d '' file; do
    sed -i.bak \
      -e "s|__GENERATE_COMMAND__|$generate_cmd_esc|g" \
      -e "s|__TEST_COMMAND__|$test_cmd_esc|g" \
      -e "s|__CONFIG_FILE__|$config_file_esc|g" \
      -e "s|__PLATFORMS__|$platforms_esc|g" \
      -e "s|__OPEN_COMMAND__|$open_command_esc|g" \
      -e "s|__MODULES_BLOCK__|$modules_block_esc|g" \
      -e "s|__CONFIG_BLOCK__|$config_block_esc|g" \
      -e "s|__ARCHITECTURE_SUMMARY__|$arch_summary_esc|g" \
      -e "s|__ARCHITECTURE_DESCRIPTION__|See CLAUDE.md and the module dependency graph.|g" \
      "$file"
    rm -f "$file.bak"
  done < <(find "$output_dir" -type f \
    \( -name "CLAUDE.md" -o -name "AGENTS.md" -o -name ".cursorrules" \
       -o -name "GEMINI.md" -o -name "ANTIGRAVITY.md" -o -name "CONVENTIONS.md" \
       -o -name ".windsurfrules" -o -name "main.mdc" \
       -o -name "ci.yml" -o -name ".gitlab-ci.yml" -o -name "bitbucket-pipelines.yml" \
       -o -name "config.yml" -o -name "XCODE_CLOUD.md" \
       -o -name "README.md" -o -name "TEMPLATE_GUIDE.md" \) -print0)

  # Pass 2: broad placeholder substitution across all text files.
  substitute_placeholders \
    "$output_dir" \
    "$app_name" "$bundle_id" "$org_name" \
    "$swift_version" "$deployment_target" \
    "$arch_name" "$build_system"

  log_success "Placeholders substituted"

  log_step "Renaming __APP_NAME__ paths…"
  rename_app_name_paths "$output_dir" "$app_name"
  log_success "Paths renamed"

  if (( do_git == 1 )); then
    log_step "Initializing git repository…"
    (
      cd "$output_dir"
      git init -q
      git checkout -q -b main 2>/dev/null || git checkout -q -B main
      git add .
      git -c commit.gpgsign=false commit -q -m "chore: scaffold $app_name from $build_system/$architecture template" || true
    )
    log_success "git repo initialized on 'main'"
  fi

  if (( do_setup == 1 )); then
    log_step "Running setup.sh…"
    (
      cd "$output_dir"
      ./setup.sh || log_warn "setup.sh failed — you can run it manually after fixing the issue."
    )
  else
    log_warn "Skipped setup.sh — run it manually inside $output_dir when ready."
  fi

  printf "\n${GREEN}${BOLD}🎉 Done!${NC}\n\n"
  printf "Next steps:\n"
  printf "  ${BOLD}cd %s${NC}\n" "$output_dir"
  if [[ "$build_system" == "tuist" ]]; then
    printf "  ${BOLD}open %s.xcworkspace${NC}\n" "$app_name"
  else
    printf "  ${BOLD}open %s.xcodeproj${NC}\n" "$app_name"
  fi
  printf "  ${BOLD}swiftlint lint --config .swiftlint.yml${NC}    ${DIM}# zero-violation policy${NC}\n"
  echo
}

# ── Sub-command: add-platform ────────────────────────────────────────────────
cmd_add_platform() {
  local in_dir="$PWD" platform=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --in)       in_dir="$2"; shift 2 ;;
      --platform) platform="$2"; shift 2 ;;
      -h|--help)  usage; exit 0 ;;
      *) log_error "Unknown flag: $1"; usage; exit 1 ;;
    esac
  done

  if [[ -z "$platform" ]]; then
    platform="$(prompt_choice "Which platform?" \
      "ipados" "macos" "visionos" "maccatalyst" "watchos")"
  fi

  in_dir="${in_dir/#\~/$HOME}"
  if [[ ! -d "$in_dir" ]]; then
    log_error "Directory not found: $in_dir"
    exit 1
  fi

  log_step "Adding $platform support to $in_dir"

  if [[ -f "$in_dir/project.yml" ]]; then
    add_platform_xcodegen "$in_dir/project.yml" "$platform"
  elif [[ -f "$in_dir/Project.swift" ]]; then
    add_platform_tuist "$in_dir/Project.swift" "$platform"
  else
    log_error "Couldn't detect project type in $in_dir (no project.yml or Project.swift)"
    exit 1
  fi

  log_success "Updated. Run setup.sh inside $in_dir to regenerate the Xcode project."
}

add_platform_xcodegen() {
  local yml="$1" platform="$2"
  local destination=""
  case "$platform" in
    ios)         destination="iOS" ;;
    ipados)      destination="iPadOS" ;;
    macos)       destination="macOS" ;;
    visionos)    destination="visionOS" ;;
    maccatalyst) destination="macCatalyst" ;;
    watchos)
      log_error "watchOS support requires a separate target. Open project.yml manually and add a watchOS target."
      exit 1
      ;;
    *) log_error "Unsupported platform: $platform"; exit 1 ;;
  esac

  if grep -q "^[[:space:]]*-[[:space:]]*$destination[[:space:]]*$" "$yml"; then
    log_warn "$destination already present in $yml"
    return
  fi

  if ! command -v python3 >/dev/null 2>&1; then
    log_warn "python3 not found — add '- $destination' under supportedDestinations: in $yml manually"
    return
  fi

  if ! python3 -c "
import re, sys
path, dest = '$yml', '$destination'
with open(path) as f:
    text = f.read()
m = re.search(r'(supportedDestinations:\n)((?:\s*-\s+\S+\n)+)', text)
if not m:
    sys.exit(2)
header, items = m.group(1), m.group(2)
indent = re.match(r'(\s*)-', items.splitlines()[0]).group(1)
new_items = items + f'{indent}- {dest}\n'
new_text = text[:m.start()] + header + new_items + text[m.end():]
with open(path, 'w') as f:
    f.write(new_text)
"; then
    log_warn "Couldn't auto-edit; please add '- $destination' under supportedDestinations: manually in $yml"
    return
  fi

  log_success "Added $destination to supportedDestinations:"
}

add_platform_tuist() {
  local swift_file="$1" platform="$2"
  local destination=""
  case "$platform" in
    ios)         destination=".iPhone" ;;
    ipados)      destination=".iPad" ;;
    macos)       destination=".mac" ;;
    visionos)    destination=".appleVision" ;;
    maccatalyst) destination=".macCatalyst" ;;
    watchos)     destination=".appleWatch" ;;
    *) log_error "Unsupported platform: $platform"; exit 1 ;;
  esac

  if grep -q "$destination" "$swift_file"; then
    log_warn "$destination already present in $swift_file"
    return
  fi
  log_warn "Tuist destinations live in code — please open $swift_file and add '$destination' to the 'destinations:' array."
  log_info "Example: destinations: [.iPhone, .iPad, $destination]"
}

# ── Dispatch ─────────────────────────────────────────────────────────────────
if [[ $# -lt 1 ]]; then
  usage
  exit 0
fi

case "$1" in
  list)          shift; list_templates ;;
  new)           shift; cmd_new "$@" ;;
  add-platform)  shift; cmd_add_platform "$@" ;;
  doctor)        shift; doctor ;;
  -h|--help)     usage ;;
  *) log_error "Unknown command: $1"; usage; exit 1 ;;
esac
